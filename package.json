{
  "name": "guangzhou-law-ai-2026-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "Guangzhou law-awareness 2D animation (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render:test": "remotion render src/index.ts TestClip out/test-2s-1080p60.mp4",
    "browser:ensure": "remotion browser ensure",
    "typecheck": "tsc --noEmit",
    "render:film": "remotion render src/index.ts Film work/film.mp4 --bundle-cache=false",
    "mix": "python -B work/audio/mix.py && python -B work/audio/check_timing.py && python -B work/audio/loudnorm.py",
    "test": "node --test work/checks/animation.cjs && python -B -m unittest discover -s work/checks -p test_audio.py",
    "render:final": "python -B work/audio/render_final.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.9.2"
  }
}
